    "chatParticipants": [
      {
        "id": "mtdevops.ai",
        "name": "mtdevops",
        "fullName": "MT DevOps Framework",
        "description": "Ask the framework's configured AI provider (ai), explain a command (ai-explain), or analyze this workspace's Terraform IAM needs (tf-ai-iam).",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain a terminal command (ai-explain)"
          },
          {
            "name": "iam",
            "description": "Analyze this workspace's Terraform IAM requirements (tf-ai-iam)"
          }
        ]
      }
    ],
    "configuration": {
      "title": "MT DevOps Companion",
      "properties": {
        "mtDevops.checkForUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub for a newer MT DevOps extension-pack release once every 24 hours and offer to install it. Use \"MT DevOps: Check for Extension Updates\" to check on demand regardless of this setting."
        }
      }
    },
