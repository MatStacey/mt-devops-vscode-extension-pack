        {
          "command": "mtDevops.secretAdd",
          "when": "view == mtDevopsSecrets && viewItem =~ /^mtDevopsSecret-/",
          "group": "1_manage@1"
        },
        {
          "command": "mtDevops.secretDelete",
          "when": "view == mtDevopsSecrets && viewItem == mtDevopsSecret-configured",
          "group": "1_manage@2"
        },
        {
          "command": "mtDevops.editConfigValue",
          "when": "view == mtDevopsSettings && viewItem == mtDevopsSettingsValue",
          "group": "1_manage@1"
        },
        {
          "command": "mtDevops.helmUninstall",
          "when": "view == mtDevopsHelm && viewItem == mtDevopsHelmRelease",
          "group": "9_cleanup"
        },
        {
          "command": "mtDevops.historyRerun",
          "when": "view == mtDevopsHistory && viewItem == mtDevopsHistoryEntry",
          "group": "1_manage@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc --noEmit -p ./",
    "sync-commands": "node scripts/generate-commands.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.23.1",
    "js-yaml": "^5.4.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "marked": "^14.1.4"
  }
}
