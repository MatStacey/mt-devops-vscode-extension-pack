{
  "name": "mt-devops-companion",
  "displayName": "MT DevOps Framework Companion",
  "description": "Command palette access to the MT DevOps Framework's full mt- command catalog, without needing to remember command names or open a terminal fuzzy-finder.",
  "version": "0.0.1",
  "publisher": "MatStacey",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatStacey/mt-devops-vscode-extension-pack",
    "directory": "packages/mt-devops-companion"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mtDevops.runCommand",
        "title": "MT DevOps: Run Command..."
      },
      {
        "command": "mtDevops.showStatus",
        "title": "MT DevOps: Show Status Dashboard"
      },
      {
        "command": "mtDevops.checkForUpdates",
        "title": "MT DevOps: Check for Extension Updates"
      },
      {
        "command": "mtDevops.copyForLLM",
        "title": "MT DevOps: Copy for LLM"
      },
      {
        "command": "mtDevops.refreshJobs",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshRepoHub",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshSecrets",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshSettings",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.editConfigValue",
        "title": "Edit Setting",
        "icon": "$(edit)"
      },
      {
        "command": "mtDevops.refreshLogs",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.clearLogs",
        "title": "Clear Logs",
        "icon": "$(clear-all)"
      },
      {
        "command": "mtDevops.openLogFile",
        "title": "Open Log File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mtDevops.tailLogsInTerminal",
        "title": "Tail in Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "mtDevops.refreshStatus",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshDoctor",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshDocker",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshKubernetes",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.dockerStart",
        "title": "Start Container",
        "icon": "$(play)"
      },
      {
        "command": "mtDevops.dockerStop",
        "title": "Stop Container",
        "icon": "$(stop-circle)"
      },
      {
        "command": "mtDevops.dockerRestart",
        "title": "Restart Container",
        "icon": "$(sync)"
      },
      {
        "command": "mtDevops.dockerLogs",
        "title": "Tail Logs",
        "icon": "$(output)"
      },
      {
        "command": "mtDevops.dockerShell",
        "title": "Open Shell (SSH)",
        "icon": "$(terminal)"
      },
      {
        "command": "mtDevops.jobRestart",
        "title": "Re-run Job",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "mtDevops.jobStop",
        "title": "Stop Job",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mtDevops.jobRemove",
        "title": "Remove from History",
        "icon": "$(trash)"
      },
      {
        "command": "mtDevops.jobsClearFinished",
        "title": "Clear Completed/Failed",
        "icon": "$(clear-all)"
      },
      {
        "command": "mtDevops.openRepoInVSCode",
        "title": "Open in VS Code",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mtDevops.indexRepo",
        "title": "Index This Repo",
        "icon": "$(sync)"
      },
      {
        "command": "mtDevops.updateRepo",
        "title": "Update This Repo (fill gaps only)",
        "icon": "$(sparkle)"
      },
      {
        "command": "mtDevops.indexCategory",
        "title": "Index All in Category",
        "icon": "$(sync)"
      },
      {
        "command": "mtDevops.updateCategory",
        "title": "Update All in Category (fill gaps only)",
        "icon": "$(sparkle)"
      },
      {
        "command": "mtDevops.indexWorkspaceRepos",
        "title": "Index All Open Repos",
        "icon": "$(sync)"
      },
      {
        "command": "mtDevops.updateWorkspaceRepos",
        "title": "Update All Open Repos (fill gaps only)",
        "icon": "$(sparkle)"
      },
      {
        "command": "mtDevops.indexAllRepos",
        "title": "Index All Repos",
        "icon": "$(sync)"
      },
      {
        "command": "mtDevops.updateAllRepos",
        "title": "Update All Repos (fill gaps only)",
        "icon": "$(sparkle)"
      },
      {
        "command": "mtDevops.showRepoReportFromExplorer",
        "title": "MT DevOps: Show Repo Report"
      },
      {
        "command": "mtDevops.indexRepoFromExplorer",
        "title": "MT DevOps: Index Repo (force reindex)"
      },
      {
        "command": "mtDevops.updateRepoIndexFromExplorer",
        "title": "MT DevOps: Update Repo Index (fill gaps only)"
      },
      {
        "command": "mtDevops.secretAdd",
        "title": "Add / Update Secret",
        "icon": "$(key)"
      },
      {
        "command": "mtDevops.secretDelete",
        "title": "Delete Secret",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mtDevops",
          "title": "MT DevOps",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mtDevops": [
        {
          "id": "mtDevopsJobs",
          "name": "Jobs"
        },
        {
          "id": "mtDevopsRepoHub",
          "name": "Repo Hub"
        },
        {
          "id": "mtDevopsSecrets",
          "name": "Secrets"
        },
        {
          "id": "mtDevopsSettings",
          "name": "Settings"
        },
        {
          "id": "mtDevopsLogs",
          "name": "Logs"
        },
        {
          "id": "mtDevopsStatus",
          "name": "Status"
        },
        {
          "id": "mtDevopsDoctor",
          "name": "Doctor"
        },
        {
          "id": "mtDevopsDocker",
          "name": "Docker"
        },
        {
          "id": "mtDevopsKubernetes",
          "name": "Kubernetes"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "mtdevops.ai",
        "name": "mtdevops",
        "fullName": "MT DevOps Framework",
        "description": "Ask the framework's configured AI provider (ai), explain a command (ai-explain), or analyze this workspace's Terraform IAM needs (tf-ai-iam).",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain a terminal command (ai-explain)"
          },
          {
            "name": "iam",
            "description": "Analyze this workspace's Terraform IAM requirements (tf-ai-iam)"
          }
        ]
      }
    ],
    "configuration": {
      "title": "MT DevOps Companion",
      "properties": {
        "mtDevops.checkForUpdatesOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub for a newer MT DevOps extension-pack release once every 24 hours and offer to install it. Use \"MT DevOps: Check for Extension Updates\" to check on demand regardless of this setting."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "mtDevops.copyForLLM",
          "group": "7_modification"
        },
        {
          "command": "mtDevops.showRepoReportFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "mtDevops.indexRepoFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        },
        {
          "command": "mtDevops.updateRepoIndexFromExplorer",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "view/title": [
        {
          "command": "mtDevops.refreshJobs",
          "when": "view == mtDevopsJobs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshRepoHub",
          "when": "view == mtDevopsRepoHub",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshSecrets",
          "when": "view == mtDevopsSecrets",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshSettings",
          "when": "view == mtDevopsSettings",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshLogs",
          "when": "view == mtDevopsLogs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.tailLogsInTerminal",
          "when": "view == mtDevopsLogs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.openLogFile",
          "when": "view == mtDevopsLogs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.clearLogs",
          "when": "view == mtDevopsLogs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshStatus",
          "when": "view == mtDevopsStatus",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshDoctor",
          "when": "view == mtDevopsDoctor",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshDocker",
          "when": "view == mtDevopsDocker",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshKubernetes",
          "when": "view == mtDevopsKubernetes",
          "group": "navigation"
        },
        {
          "command": "mtDevops.jobsClearFinished",
          "when": "view == mtDevopsJobs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.updateAllRepos",
          "when": "view == mtDevopsRepoHub",
          "group": "navigation"
        },
        {
          "command": "mtDevops.indexAllRepos",
          "when": "view == mtDevopsRepoHub",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mtDevops.dockerStart",
          "when": "view == mtDevopsDocker && viewItem == mtDevopsContainer-stopped",
          "group": "1_lifecycle@1"
        },
        {
          "command": "mtDevops.dockerStop",
          "when": "view == mtDevopsDocker && viewItem == mtDevopsContainer-running",
          "group": "1_lifecycle@2"
        },
        {
          "command": "mtDevops.dockerRestart",
          "when": "view == mtDevopsDocker && viewItem == mtDevopsContainer-running",
          "group": "1_lifecycle@3"
        },
        {
          "command": "mtDevops.dockerLogs",
          "when": "view == mtDevopsDocker && viewItem =~ /^mtDevopsContainer-/",
          "group": "2_diagnostics@1"
        },
        {
          "command": "mtDevops.dockerShell",
          "when": "view == mtDevopsDocker && viewItem == mtDevopsContainer-running",
          "group": "2_diagnostics@2"
        },
        {
          "command": "mtDevops.jobRestart",
          "when": "view == mtDevopsJobs && viewItem =~ /^mtDevopsJob-/",
          "group": "1_lifecycle@1"
        },
        {
          "command": "mtDevops.jobStop",
          "when": "view == mtDevopsJobs && viewItem == mtDevopsJob-running",
          "group": "1_lifecycle@2"
        },
        {
          "command": "mtDevops.jobRemove",
          "when": "view == mtDevopsJobs && viewItem =~ /^mtDevopsJob-/",
          "group": "9_cleanup"
        },
        {
          "command": "mtDevops.openRepoInVSCode",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsRepo",
          "group": "1_open"
        },
        {
          "command": "mtDevops.indexRepo",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsRepo",
          "group": "2_index@1"
        },
        {
          "command": "mtDevops.updateRepo",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsRepo",
          "group": "2_index@2"
        },
        {
          "command": "mtDevops.indexCategory",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsRepoCategory",
          "group": "2_index@1"
        },
        {
          "command": "mtDevops.updateCategory",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsRepoCategory",
          "group": "2_index@2"
        },
        {
          "command": "mtDevops.indexWorkspaceRepos",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsWorkspaceCategory",
          "group": "2_index@1"
        },
        {
          "command": "mtDevops.updateWorkspaceRepos",
          "when": "view == mtDevopsRepoHub && viewItem == mtDevopsWorkspaceCategory",
          "group": "2_index@2"
        },
        {
          "command": "mtDevops.secretAdd",
          "when": "view == mtDevopsSecrets && viewItem =~ /^mtDevopsSecret-/",
          "group": "1_manage@1"
        },
        {
          "command": "mtDevops.secretDelete",
          "when": "view == mtDevopsSecrets && viewItem == mtDevopsSecret-configured",
          "group": "1_manage@2"
        },
        {
          "command": "mtDevops.editConfigValue",
          "when": "view == mtDevopsSettings && viewItem == mtDevopsSettingsValue",
          "group": "1_manage@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc --noEmit -p ./",
    "sync-commands": "node scripts/generate-commands.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.23.1",
    "js-yaml": "^5.4.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "marked": "^14.1.4"
  }
}
