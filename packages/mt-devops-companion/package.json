{
  "name": "mt-devops-companion",
  "displayName": "MT DevOps Framework Companion",
  "description": "Command palette access to the MT DevOps Framework's full mt- command catalog, without needing to remember command names or open a terminal fuzzy-finder.",
  "version": "0.0.1",
  "publisher": "MatStacey",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatStacey/mt-devops-vscode-extension-pack",
    "directory": "packages/mt-devops-companion"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mtDevops.runCommand",
        "title": "MT DevOps: Run Command..."
      },
      {
        "command": "mtDevops.showStatus",
        "title": "MT DevOps: Show Status Dashboard"
      },
      {
        "command": "mtDevops.copyForLLM",
        "title": "MT DevOps: Copy for LLM"
      },
      {
        "command": "mtDevops.refreshJobs",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshRepoHub",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshSecrets",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshStatus",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshDoctor",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshDocker",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mtDevops.refreshKubernetes",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mtDevops",
          "title": "MT DevOps",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mtDevops": [
        {
          "id": "mtDevopsJobs",
          "name": "Jobs"
        },
        {
          "id": "mtDevopsRepoHub",
          "name": "Repo Hub"
        },
        {
          "id": "mtDevopsSecrets",
          "name": "Secrets"
        },
        {
          "id": "mtDevopsStatus",
          "name": "Status"
        },
        {
          "id": "mtDevopsDoctor",
          "name": "Doctor"
        },
        {
          "id": "mtDevopsDocker",
          "name": "Docker"
        },
        {
          "id": "mtDevopsKubernetes",
          "name": "Kubernetes"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "mtdevops.ai",
        "name": "mtdevops",
        "fullName": "MT DevOps Framework",
        "description": "Ask the framework's configured AI provider (ai), explain a command (ai-explain), or analyze this workspace's Terraform IAM needs (tf-ai-iam).",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain a terminal command (ai-explain)"
          },
          {
            "name": "iam",
            "description": "Analyze this workspace's Terraform IAM requirements (tf-ai-iam)"
          }
        ]
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mtDevops.copyForLLM",
          "group": "7_modification"
        }
      ],
      "view/title": [
        {
          "command": "mtDevops.refreshJobs",
          "when": "view == mtDevopsJobs",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshRepoHub",
          "when": "view == mtDevopsRepoHub",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshSecrets",
          "when": "view == mtDevopsSecrets",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshStatus",
          "when": "view == mtDevopsStatus",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshDoctor",
          "when": "view == mtDevopsDoctor",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshDocker",
          "when": "view == mtDevopsDocker",
          "group": "navigation"
        },
        {
          "command": "mtDevops.refreshKubernetes",
          "when": "view == mtDevopsKubernetes",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "compile": "tsc --noEmit -p ./",
    "sync-commands": "node scripts/generate-commands.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.23.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.5.4"
  }
}
