    "viewsWelcome": [
      {
        "view": "mtDevopsExportWizard",
        "contents": "Right-click a repo in Repo Radar and choose \"Export Wizard (GUI)\", or run the command below on the current folder.\n[Open Export Wizard](command:mtDevops.openExportWizardFromExplorer)"
