{
  "name": "mt-devops-companion",
  "displayName": "MT DevOps Framework Companion",
  "description": "Command palette access to the MT DevOps Framework's full mt- command catalog, without needing to remember command names or open a terminal fuzzy-finder.",
  "version": "0.0.1",
  "publisher": "MatStacey",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatStacey/mt-devops-vscode-extension-pack",
    "directory": "packages/mt-devops-companion"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
